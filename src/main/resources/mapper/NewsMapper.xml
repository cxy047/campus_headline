<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chenxy.mapper.NewsMapper">

    <!-- 基础字段 resultMap，复用给自定义查询 -->
    <resultMap id="newsResultMap" type="com.chenxy.entity.News">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="author" property="author"/>
        <result column="user_id" property="userId"/>
        <result column="category" property="category"/>
        <result column="views" property="views"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- ============ 基础 CRUD（由 BaseMapper 提供，这里保留自定义 SQL） ============ -->

    <select id="findAll" resultMap="newsResultMap">
        SELECT * FROM news
        WHERE status = 2
        ORDER BY create_time DESC
    </select>

    <select id="findById" resultMap="newsResultMap">
        SELECT * FROM news WHERE id = #{id}
    </select>

    <insert id="add" parameterType="com.chenxy.entity.News" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO news(title,content,author,category,views,status)
        VALUES(#{title},#{content},#{author},#{category},#{views},#{status})
    </insert>

    <update id="update" parameterType="com.chenxy.entity.News">
        UPDATE news
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="author != null">author = #{author},</if>
            <if test="category != null">category = #{category},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM news WHERE id = #{id}
    </delete>

    <!-- ============ MyBatis 动态 SQL：多条件分页查询 ============ -->
    <!-- 使用 <where> + <if> 实现条件拼接，支持搜索关键字、分类、状态筛选 -->
    <select id="selectNewsPage" resultMap="newsResultMap">
        SELECT * FROM news
        <where>
            <if test="params.title != null and params.title != ''">
                AND title LIKE CONCAT('%', #{params.title}, '%')
            </if>
            <if test="params.category != null and params.category != ''">
                AND category = #{params.category}
            </if>
            <if test="params.status != null">
                AND status = #{params.status}
            </if>
            <if test="params.author != null and params.author != ''">
                AND author LIKE CONCAT('%', #{params.author}, '%')
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="params.orderBy != null and params.orderBy == 'views'">views DESC</when>
            <otherwise>create_time DESC</otherwise>
        </choose>
    </select>

    <!-- ============ 浏览量自增 ============ -->
    <update id="incrementViews">
        UPDATE news SET views = views + 1 WHERE id = #{id}
    </update>

</mapper>
